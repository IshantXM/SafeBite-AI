{
  "rule_set_name": "Legal Metrology (Packaged Commodities) Rules, 2011 (v2.4)",
  "version": "2.4",
  "statutory_act": "The Legal Metrology Act, 2009 (Act No. 1 of 2010)",
  "enforcing_authority": "Department of Consumer Affairs (DOCA), Ministry of Consumer Affairs, Food and Public Distribution, Government of India",
  "default_penalties": {
    "section_36_1_first_offence": 25000.0,
    "section_36_1_second_offence": 50000.0,
    "section_36_1_subsequent_offence": 100000.0,
    "section_36_2_quantity_error": 50000.0
  },
  "rules": [
    {
      "rule_id": "LM_RULE_6_1_A",
      "clause_reference": "Rule 6(1)(a)",
      "field_key": "MANUFACTURER_NAME_ADDRESS",
      "description": "Name and complete postal address of the manufacturer / packer / importer.",
      "mandatory": true,
      "severity": "CRITICAL",
      "default_penalty_inr": 25000.0,
      "validation_criteria": {
        "required": true,
        "min_characters": 10,
        "required_address_components": ["pincode", "state_or_city"]
      }
    },
    {
      "rule_id": "LM_RULE_6_1_B_UNITS",
      "clause_reference": "Rule 6(1)(b)",
      "field_key": "NET_QUANTITY",
      "description": "Net quantity in legal SI units without prohibited qualifiers.",
      "mandatory": true,
      "severity": "CRITICAL",
      "default_penalty_inr": 25000.0,
      "validation_criteria": {
        "required": true,
        "valid_si_units": ["g", "kg", "ml", "l", "m", "cm", "mm", "N", "U", "units", "pieces"],
        "prohibited_qualifiers": [
          "approx",
          "approximate",
          "when packed",
          "jumbo",
          "family size",
          "extra large",
          "economy pack",
          "around"
        ]
      }
    },
    {
      "rule_id": "LM_RULE_6_1_C_MRP",
      "clause_reference": "Rule 6(1)(c)",
      "field_key": "MAXIMUM_RETAIL_PRICE",
      "description": "MRP declaration strictly including mandatory phrase 'inclusive of all taxes' or 'incl. of all taxes' in INR format.",
      "mandatory": true,
      "severity": "CRITICAL",
      "default_penalty_inr": 25000.0,
      "validation_criteria": {
        "required": true,
        "currency_indicators": ["₹", "Rs", "Rs.", "INR"],
        "tax_inclusivity_phrases": [
          "inclusive of all taxes",
          "incl. of all taxes",
          "incl of all taxes",
          "incl. all taxes"
        ],
        "require_numeric_price": true
      }
    },
    {
      "rule_id": "LM_RULE_6_1_D_DATE",
      "clause_reference": "Rule 6(1)(d)",
      "field_key": "MFG_DATE",
      "description": "Month and Year of manufacture, pre-packing, or import.",
      "mandatory": true,
      "severity": "HIGH",
      "default_penalty_inr": 25000.0,
      "validation_criteria": {
        "required": true
      }
    },
    {
      "rule_id": "LM_RULE_6_1_E_CONSUMER_CARE",
      "clause_reference": "Rule 6(1)(e)",
      "field_key": "CONSUMER_CARE",
      "description": "Consumer Care contact details (Name, Address, Telephone, Email).",
      "mandatory": true,
      "severity": "HIGH",
      "default_penalty_inr": 25000.0,
      "validation_criteria": {
        "required": true,
        "require_email_or_phone": true
      }
    },
    {
      "rule_id": "LM_SCHEDULE_II_FONT_HEIGHT",
      "clause_reference": "Rule 7 / Schedule II",
      "field_key": "FONT_HEIGHT_CALIBRATION",
      "description": "Minimum font & numeral height dynamically mapped to Principal Display Panel (PDP) surface area using EAN-13 barcode scale.",
      "mandatory": true,
      "severity": "HIGH",
      "default_penalty_inr": 25000.0,
      "pdp_area_thresholds": [
        { "area_cm2_min": 0, "area_cm2_max": 50, "min_numeral_height_mm": 1.0, "min_letter_height_mm": 1.0 },
        { "area_cm2_min": 50, "area_cm2_max": 200, "min_numeral_height_mm": 2.0, "min_letter_height_mm": 1.5 },
        { "area_cm2_min": 200, "area_cm2_max": 1000, "min_numeral_height_mm": 4.0, "min_letter_height_mm": 2.0 },
        { "area_cm2_min": 1000, "area_cm2_max": 999999, "min_numeral_height_mm": 6.0, "min_letter_height_mm": 3.0 }
      ]
    }
  ]
}
