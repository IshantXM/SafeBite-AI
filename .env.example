# ==============================================================================
# SafetyBite-AI (Legal Metrology Sentinel) Environment Configuration Template
# Ministry of Consumer Affairs (DOCA), Government of India
# ==============================================================================

# General
ENVIRONMENT=production
PROJECT_NAME="SafetyBite-AI"
SECRET_KEY=sentinel_prod_sec_key_change_in_production_89f1a23c4d5e
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://sentinel.consumeraffairs.gov.in"]

# PostgreSQL 16 + PostGIS
POSTGRES_SERVER=postgres-postgis
POSTGRES_PORT=5432
POSTGRES_DB=lms_sentinel
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=sentinel_secure_password_2026
DATABASE_URL=postgresql+asyncpg://sentinel_admin:sentinel_secure_password_2026@postgres-postgis:5432/lms_sentinel
DATABASE_SYNC_URL=postgresql://sentinel_admin:sentinel_secure_password_2026@postgres-postgis:5432/lms_sentinel

# Google OAuth2 Social Sign-In
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# LLM API Keys (Gemini / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Keycloak Identity & RBAC
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=SafetyBite-AI
KEYCLOAK_CLIENT_ID=sentinel-api
KEYCLOAK_CLIENT_SECRET=sentinel_keycloak_secret_2026
KEYCLOAK_PUBLIC_KEY=

# Redis (Celery Broker & Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=sentinel_redis_pass_2026
CELERY_BROKER_URL=redis://:sentinel_redis_pass_2026@redis:6379/0
CELERY_RESULT_BACKEND=redis://:sentinel_redis_pass_2026@redis:6379/1

# MinIO / S3 Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=sentinel_minio_admin
MINIO_ROOT_PASSWORD=sentinel_minio_secret_key_2026
MINIO_BUCKET_INSPECTIONS=sentinel-inspections
MINIO_BUCKET_REPORTS=sentinel-reports
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000

# Elasticsearch 8
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=sentinel_elastic_pass_2026

# Report Generator & PKI Signing
REPORT_GENERATOR_URL=http://report-generator:8002
PKI_CERT_PATH=/etc/sentinel/certs/doca_officer_cert.pem
PKI_KEY_PATH=/etc/sentinel/certs/doca_officer_key.pem
PKI_SIGNER_NAME="Director of Legal Metrology, DOCA, Govt of India"
PKI_SIGNER_LOCATION="New Delhi, India"

# AI Inference & Vision Pipeline
YOLO_MODEL_PATH=/app/models/yolov8_lms_package_v1.pt
PADDLE_OCR_LANG=en,hi
SPACY_MODEL=en_core_web_sm
CLAHE_CLIP_LIMIT=2.5
CLAHE_GRID_SIZE=8
EAN13_NOMINAL_WIDTH_MM=37.29

# Web Dashboard
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAPBOX_TOKEN=pk.sentinel_sample_mapbox_token_optional
